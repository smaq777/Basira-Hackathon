# Backend configuration. Never put a secret in a VITE_* variable.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Public browser configuration only; never put a secret here.
VITE_API_BASE_URL=
# Optional browser-native, session-grounded voice proof of value. Keep disabled unless
# the deployment has been explicitly selected for the voice evaluation.
VITE_SESSION_VOICE_ENABLED=false
# Clerk's publishable key is intentionally browser-visible. It is not the secret key.
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk backend verification. Keep the secret key only in the server environment.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Exact comma-separated application origins accepted by Clerk token verification.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Authorization policy. Keep allowlist for production. `authenticated` is intended only for a
# time-bounded hackathon staging demo where every signed-in Clerk user may enter.
CLERK_REVIEWER_ACCESS_MODE=allowlist
# Comma-separated Clerk user IDs approved as reviewers when access mode is allowlist.
CLERK_REVIEWER_USER_IDS=
# Exact Clerk Frontend API origin used only to construct the response CSP.
CLERK_FRONTEND_API_ORIGIN=
# Pooled least-privilege runtime URL. Direct owner credentials must not be used here.
DATABASE_URL=
# verify-full is the secure default. Use require only when a managed provider encrypts
# connections with a platform certificate that is not in the public trust store.
DATABASE_TLS_MODE=verify-full
# Direct owner URL for explicit migration commands only. Do not configure it on Railway.
DATABASE_URL_UNPOOLED=
# Human-review tickets. Keys are server-only; generate independent random values per environment.
TICKETS_ENABLED=false
# Base64-encoded 32-byte AES key, for example: openssl rand -base64 32
TICKET_DATA_KEY=
# At least 32 random characters, for example: openssl rand -hex 32
TICKET_LOOKUP_PEPPER=
# Brevo transactional email. Configure all four values together or leave all blank.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=بصيرة
PUBLIC_APP_URL=http://localhost:3000
TAFSIR_MCP_URL=https://mcp.tafsir.net/mcp
DORAR_ENABLED=false
COHERE_API_KEY=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=embed-v4.0
EMBEDDING_DIMENSION=1024
GUEST_RETENTION_HOURS=24
# Non-secret review lifecycle limits. Review processing must terminate or become interrupted
# before this deadline; the corpus version is recorded for reproducibility.
REVIEW_DEADLINE_SECONDS=60
CORPUS_VERSION=unconfigured
# Source-backed review bridge. Disabled until migration 0007 and an approved corpus exist.
FOUNDATION_ENABLED=false
FOUNDATION_REWRITE_ENABLED=false
# Research editions may be tested only in non-production on a loopback HOST.
FOUNDATION_RESEARCH_PREVIEW=false
# Explicit public hackathon demo profile. Reads only a pinned research corpus and
# keeps every result labelled research-only/pending. Live MCP acquisition, web
# discovery/cache writes and rewrite must remain off in this profile.
FOUNDATION_HOSTED_DEMO=false
# Absolute Python 3.11+ executable, read-only SQLite index, and optional snapshot directory.
FOUNDATION_PYTHON=
FOUNDATION_DATABASE=
FOUNDATION_SNAPSHOTS=
# Separate least-privilege login with basirah_worker membership. Never an owner URL.
REVIEW_WORKER_DATABASE_URL=
# Optional bounded Tafsir MCP acquisition for missing local context. Requires
# loopback research preview. Sends numeric references, never the user's draft.
# Rewriting remains unavailable; the separate semantic pilot flag below defaults off.
FOUNDATION_TAFSIR_LIVE=false
# Optional local research model pilot. Sends the draft and selected source text to OpenRouter.
# Obtain consent for the test payload before enabling; production activation is unsupported.
FOUNDATION_SEMANTIC_ENABLED=false
OPENROUTER_API_KEY=
# Allowlisted assessment route; both stages use low reasoning. No automatic supplier fallback configured.
FOUNDATION_ASSESSOR_MODEL=openai/gpt-6.1-sol

# Experimental claim-driven Neon retrieval. Requires migration 0009, semantic research
# preview, and a populated versioned corpus. Defaults off; no production activation.
FOUNDATION_CLAIM_RETRIEVAL_ENABLED=false
# Separate least-privilege corpus reader URL; never use an owner connection here.
FOUNDATION_CORPUS_DATABASE_URL=
FOUNDATION_CORPUS_VERSION=
FOUNDATION_CORPUS_TLS_MODE=verify-full

# Optional bounded Firecrawl acquisition after an explicit semantic evidence gap.
# Requires claim retrieval and local research preview. At most one claim per run.
FOUNDATION_WEB_DISCOVERY_ENABLED=false
FIRECRAWL_API_KEY=
# Empty uses bundled config/source-policy.json; trusted operator override only.
FOUNDATION_WEB_POLICY_PATH=

# Optional reusable public-page research cache; separate least-privilege Neon writer.
FOUNDATION_WEB_CACHE_ENABLED=false
# Default-off retained-page passage search; apply 0011/0012 and explicitly backfill first.
FOUNDATION_WEB_CACHE_PASSAGES_ENABLED=false
FOUNDATION_WEB_CACHE_DATABASE_URL=
# Defaults remain short. Authorized research profile with cache:
# semantic=240000, extraction=20000, assessment=90000, discovery=65000, gap assessment=45000,
# REVIEW_DEADLINE_SECONDS=300. Discovery includes bounded classification/cache writes.
FOUNDATION_SEMANTIC_TIMEOUT_MS=60000
FOUNDATION_ASSESSMENT_TIMEOUT_MS=45000
FOUNDATION_EXTRACTION_TIMEOUT_MS=12000
FOUNDATION_WEB_DISCOVERY_TIMEOUT_MS=8000
FOUNDATION_GAP_ASSESSMENT_TIMEOUT_MS=18000
# Optional research extensions: retrieval=60000, reserve=90000, cache=20000,
# embedding=2000, page/content SQL=5000, passage SQL=3000, connection=5000, pool=6.
# These bounded phase ceilings do not guarantee every query or source is delivered.
FOUNDATION_RETRIEVAL_TIMEOUT_MS=12000
FOUNDATION_RETRIEVAL_ASSESSMENT_RESERVE_MS=0
FOUNDATION_CACHE_TIMEOUT_MS=3000
FOUNDATION_CACHE_QUERY_EMBEDDING_TIMEOUT_MS=1500
FOUNDATION_CACHE_SQL_TIMEOUT_MS=5000
FOUNDATION_CACHE_PASSAGE_SQL_TIMEOUT_MS=1000
FOUNDATION_CACHE_CONTENT_SQL_TIMEOUT_MS=5000
FOUNDATION_CORPUS_CONNECTION_TIMEOUT_MS=5000
FOUNDATION_CORPUS_POOL_MAX=3

# Explicit optional provider choice: firecrawl or tinyfish_first (Firecrawl fallback).
FOUNDATION_WEB_PROVIDER=firecrawl
TINYFISH_API_KEY=
