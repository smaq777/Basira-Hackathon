# Backend configuration. Never put a secret in a VITE_* variable.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Public browser configuration only; never put a secret here.
VITE_API_BASE_URL=
# Optional browser-native, session-grounded voice proof of value. Keep disabled unless
# the deployment has been explicitly selected for the voice evaluation.
VITE_SESSION_VOICE_ENABLED=false
# Clerk's publishable key is intentionally browser-visible. It is not the secret key.
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk backend verification. Keep the secret key only in the server environment.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Exact comma-separated application origins accepted by Clerk token verification.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Authorization policy. Keep allowlist for production. `authenticated` is intended only for a
# time-bounded hackathon staging demo where every signed-in Clerk user may enter.
CLERK_REVIEWER_ACCESS_MODE=allowlist
# Comma-separated Clerk user IDs approved as reviewers when access mode is allowlist.
CLERK_REVIEWER_USER_IDS=
# Exact Clerk Frontend API origin used only to construct the response CSP.
CLERK_FRONTEND_API_ORIGIN=
# Pooled least-privilege runtime URL. Direct owner credentials must not be used here.
DATABASE_URL=
# verify-full is the secure default. Use require only when a managed provider encrypts
# connections with a platform certificate that is not in the public trust store.
DATABASE_TLS_MODE=verify-full
# Direct owner URL for explicit migration commands only. Do not configure it on Railway.
DATABASE_URL_UNPOOLED=
TAFSIR_MCP_URL=https://mcp.tafsir.net/mcp
DORAR_ENABLED=false
COHERE_API_KEY=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=embed-v4.0
EMBEDDING_DIMENSION=1024
GUEST_RETENTION_HOURS=24
# Non-secret review lifecycle limits. Review processing must terminate or become interrupted
# before this deadline; the corpus version is recorded for reproducibility.
REVIEW_DEADLINE_SECONDS=60
CORPUS_VERSION=unconfigured
# Source-backed review bridge. Disabled until migration 0007 and an approved corpus exist.
FOUNDATION_ENABLED=false
# Research editions may be tested only in non-production on a loopback HOST.
FOUNDATION_RESEARCH_PREVIEW=false
# Absolute Python 3.11+ executable, read-only SQLite index, and optional snapshot directory.
FOUNDATION_PYTHON=
FOUNDATION_DATABASE=
FOUNDATION_SNAPSHOTS=
# Separate least-privilege login with basirah_worker membership. Never an owner URL.
REVIEW_WORKER_DATABASE_URL=
# Optional bounded Tafsir MCP acquisition for missing local context. Requires
# loopback research preview. Sends numeric references, never the user's draft.
# Rewriting remains unavailable; the separate semantic pilot flag below defaults off.
FOUNDATION_TAFSIR_LIVE=false
# Optional local research model pilot. Sends the draft and selected source text to OpenRouter.
# Obtain consent for the test payload before enabling; production activation is unsupported.
FOUNDATION_SEMANTIC_ENABLED=false
OPENROUTER_API_KEY=
# Allowlisted assessment route; both stages use low reasoning. No automatic supplier fallback configured.
FOUNDATION_ASSESSOR_MODEL=openai/gpt-6.1-sol
