{
  "name": "basirah",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pre-hackathon engineering foundation for evidence-linked Arabic content review",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:verify": "node scripts/verify-database.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-docs.mjs",
    "policy:check": "node scripts/check-policy.mjs",
    "check": "npm run typecheck && npm test && npm run docs:check && npm run policy:check && npm run format:check && npm run build",
    "build": "tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "start": "node dist/apps/api/src/server.js"
  },
  "dependencies": {
    "@clerk/express": "^2.1.75",
    "@clerk/localizations": "^4.21.2",
    "@clerk/react": "^6.17.5",
    "@fontsource/cairo": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "express": "5.2.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
